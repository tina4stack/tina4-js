{
  "name": "tina4js",
  "version": "1.7.2",
  "description": "1.5KB core gzipped, reactive framework \u2014 signals, web components, routing, PWA",
  "type": "module",
  "main": "dist/tina4.cjs.js",
  "module": "dist/tina4.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/tina4.es.js",
      "require": "./dist/tina4.cjs.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core.es.js"
    },
    "./router": {
      "types": "./dist/router/index.d.ts",
      "import": "./dist/router.es.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api.es.js"
    },
    "./pwa": {
      "types": "./dist/pwa/index.d.ts",
      "import": "./dist/pwa.es.js"
    },
    "./push": {
      "types": "./dist/push.d.ts",
      "import": "./dist/push.es.js"
    },
    "./debug": {
      "types": "./dist/debug/index.d.ts",
      "import": "./dist/debug.es.js"
    },
    "./ws": {
      "types": "./dist/ws/index.d.ts",
      "import": "./dist/ws.es.js"
    },
    "./sse": {
      "types": "./dist/sse/index.d.ts",
      "import": "./dist/sse.es.js"
    },
    "./rtc": {
      "types": "./dist/rtc/index.d.ts",
      "import": "./dist/rtc.es.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage.es.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n.es.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "import": "./dist/ai.es.js"
    }
  },
  "sideEffects": false,
  "bin": {
    "tina4js": "./bin/tina4.js"
  },
  "files": [
    "dist/",
    "bin/",
    "TINA4.md",
    "NOTICE",
    "COMMERCIAL-LICENSE.md"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "build:iife": "esbuild src/index.ts --bundle --minify --format=iife --global-name=Tina4 --outfile=dist/tina4js.min.js --target=es2021",
    "pretest": "npm run build && npm run build:iife",
    "test": "node --import ./scripts/register-ts.mjs --import ./scripts/test-setup.mjs --test \"tests/**/*.test.ts\"",
    "test:watch": "node --import ./scripts/register-ts.mjs --import ./scripts/test-setup.mjs --test --watch \"tests/**/*.test.ts\"",
    "pretest:size": "npm run build && npm run build:iife",
    "test:size": "node --import ./scripts/register-ts.mjs --import ./scripts/test-setup.mjs --test tests/size.test.ts",
    "build:gallery": "esbuild examples/gallery/_entry.ts --bundle --minify --format=iife --global-name=tina4 --outfile=examples/gallery/tina4.bundle.js --target=es2021"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "happy-dom": "^20.8.9",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "framework",
    "signals",
    "web-components",
    "pwa",
    "lightweight",
    "reactive",
    "tina4"
  ],
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tina4stack/tina4-js"
  }
}
